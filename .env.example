# Скопировать в .env и заполнить. Файл .env не попадает в git.

# Ключ для встраиваний памяти memgraph (text-embedding-3-small, 512 измерений).
# Без него работают только чисто SQL-команды обёртки (session-context и подобные);
# recall, ingest-docs и записи с встраиванием требуют ключ.
OPENAI_API_KEY=

# Ключи сборщика роликов tools/post2video/render.py (читаются из окружения, затем отсюда,
# затем из ~/Projects/VoiceAgent/.env). Replicate — генерация клипов; xAI — голос.
REPLICATE_API_KEY=
XAI_API_KEY=
